# Comma separated absolute instance base URLs used by the connection manager.
# Leave it empty to use the origin that serves the page (single instance or the
# Vite development proxy).
#
# Example with three instances on the demo laptop:
# VITE_INSTANCE_URLS=http://192.168.1.5:3001,http://192.168.1.5:3002,http://192.168.1.5:3003
VITE_INSTANCE_URLS=

# Backend target of the Vite development proxy. This variable is read by the
# dev server only and is never exposed to the browser bundle.
UNISON_BACKEND_URL=http://127.0.0.1:3000
